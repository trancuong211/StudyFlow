# LOCAL DEVELOPMENT ONLY. Never commit real secrets.
DEBUG=True
SECRET_KEY=change-me-local-development-key-only
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://localhost:8000

# SQLite for quick local run; Docker/Render override USE_SQLITE=False.
USE_SQLITE=True
DATABASE_URL=postgres://studyflow_user:studyflow_local_only@localhost:5432/studyflow_db
POSTGRES_PASSWORD=studyflow_local_only
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/oauth2callback/

# Console prints development emails. Production must use SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=StudyFlow <noreply@studyflow.local>
# MEDIA_ROOT=/absolute/path/to/persistent/media
