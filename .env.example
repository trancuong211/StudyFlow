# Django Core Settings
SECRET_KEY=django-insecure-studyflow-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database Configuration (PostgreSQL)
# For local dev without Postgres, leave empty or set USE_SQLITE=True
USE_SQLITE=False
DB_NAME=StudyFlow_db
DB_USER=postgres
DB_PASSWORD=trancuong211
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8001
OPENAI_API_KEY=your-openai-api-key-here
CLAUDE_API_KEY=your-claude-api-key-here

# Google Calendar OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/oauth2callback/

# Email Settings (for reminders)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
